{
  "name": "battleship-vs-ai",
  "version": "1.0.0",
  "private": true,
  "description": "人間 vs AI で遊べるシンプルなWeb版Battleship",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
